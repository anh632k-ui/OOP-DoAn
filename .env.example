# MED-06 - development values only; change passwords outside local development.
POSTGRES_DB=med06
POSTGRES_USER=med06
POSTGRES_PASSWORD=med06_dev_password
POSTGRES_PORT=5432
BACKEND_PORT=3001
FRONTEND_PORT=3000

# Stage 3: generate a local random JWT signing secret (min 32 bytes).
# DO NOT commit .env or copy real secrets into GitHub.
JWT_SECRET=

# Optional S3-compatible object storage (Docker profile: storage).
# Set unique development credentials. Never commit local .env.
OBJECT_STORAGE_ACCESS_KEY=med06_local_access
OBJECT_STORAGE_SECRET_KEY=replace_with_long_random_secret
OBJECT_STORAGE_PORT=8333
