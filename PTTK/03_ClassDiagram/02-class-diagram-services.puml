@startuml
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam nodesep 45
skinparam ranksep 50
hide circle
hide stereotypes

title MED-06 - BIỂU ĐỒ LỚP: CÁC DỊCH VỤ ỨNG DỤNG

package "Quản lý sự kiện" {
  class "Dịch vụ sự kiện" as DVSuKien {
    + tạoSựKiện(...): SuKien
    + cậpNhậtSựKiện(...): SuKien
    + côngBốSựKiện(...): SuKien
    + hủySựKiện(...): void
  }
  class "Dịch vụ suất" as DVSuat {
    + tạoSuất(...): SuatSuKien
    + cậpNhậtSuất(...): SuatSuKien
    + mởĐăngKý(...): void
    + đóngĐăngKý(...): void
  }
  class "Dịch vụ hỗ trợ tiếp cận" as DVHoTro {
    + gánĐặcTínhChoSựKiện(...): void
    + tìmSựKiệnTheoĐặcTính(...): SuKien[]
  }
  DVSuKien --> DVSuat
  DVSuKien --> DVHoTro
}

package "Đăng ký và vé" {
  class "Dịch vụ đăng ký" as DVDangKy {
    + đăngKý(...): DangKy
    + hủyĐăngKý(...): void
  }
  class "Dịch vụ chống bot" as DVChongBot {
    + kiểmTraYêuCầuĐăngKý(...): void
  }
  class "Dịch vụ phân bổ" as DVPhanBo {
    + phânBổNgay(...): void
    + chạyPhânBổ(...): LanPhanBo
  }
  class "Dịch vụ danh sách chờ" as DVDanhSachCho {
    + thêmVàoDanhSách(...): DanhSachCho
    + chọnNgườiTiếpTheo(...): DangKy?
  }
  class "Dịch vụ vé" as DVVe {
    + phátVé(...): Ve
    + hủyVé(...): void
    + tìmTheoMã(...): Ve
  }
  class "Dịch vụ check-in" as DVCheckIn {
    + checkIn(...): LuotCheckIn
  }

  DVDangKy --> DVChongBot
  DVDangKy --> DVPhanBo
  DVPhanBo --> DVDanhSachCho
  DVPhanBo --> DVVe
  DVDangKy --> DVVe
  DVCheckIn --> DVVe

  DVDangKy -[hidden]right- DVPhanBo
  DVPhanBo -[hidden]right- DVVe
  DVChongBot -[hidden]right- DVDanhSachCho
  DVDanhSachCho -[hidden]right- DVCheckIn
}

DVSuat --> DVDangKy : hủy dây chuyền
@enduml
