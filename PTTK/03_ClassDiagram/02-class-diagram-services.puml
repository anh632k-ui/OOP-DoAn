@startuml
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam nodesep 45
skinparam ranksep 50
hide circle
hide stereotypes

title MED-06 - CLASS DIAGRAM: APPLICATION SERVICES

package "Event Management" {
  class EventService {
    + createEvent(...): Event
    + updateEvent(...): Event
    + publishEvent(...): Event
    + cancelEvent(...): void
  }
  class SessionService {
    + createSession(...): EventSession
    + updateSession(...): EventSession
    + openRegistration(...): void
    + closeRegistration(...): void
  }
  class AccessibilityService {
    + setEventFeatures(...): void
    + findEventsByFeatures(...): Event[]
  }

  EventService --> SessionService
  EventService --> AccessibilityService
}

package "Registration & Ticketing" {
  class RegistrationService {
    + register(...): Registration
    + cancelRegistration(...): void
  }
  class BotProtectionService {
    + validateRegistrationRequest(...): void
  }
  class AllocationService {
    + allocateImmediate(...): void
    + runAllocation(...): AllocationRun
  }
  class WaitlistService {
    + enqueue(...): WaitlistEntry
    + promoteNext(...): Registration?
  }
  class TicketService {
    + issueTicket(...): Ticket
    + cancelTicket(...): void
    + findByCode(...): Ticket
  }
  class CheckInService {
    + checkIn(...): CheckIn
  }

  RegistrationService --> BotProtectionService
  RegistrationService --> AllocationService
  AllocationService --> WaitlistService
  AllocationService --> TicketService
  RegistrationService --> TicketService
  CheckInService --> TicketService

  RegistrationService -[hidden]right- AllocationService
  AllocationService -[hidden]right- TicketService
  BotProtectionService -[hidden]right- WaitlistService
  WaitlistService -[hidden]right- CheckInService
}

SessionService --> RegistrationService : cancel cascade

@enduml
