@startuml
skinparam class {
 BackgroundColor #FFF8CE
 BorderColor #C05773
 ArrowColor #C05773
 FontColor #222222
}
top to bottom direction
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam nodesep 45
skinparam ranksep 50
hide circle
hide stereotypes

title MED-06 - BIỂU ĐỒ LỚP: CÁC DỊCH VỤ ỨNG DỤNG

package "Quản lý sự kiện" {
  class "Dịch vụ sự kiện" as DVSuKien {
    + tạoSựKiện(mãNgườiTổChức: UUID, dữLiệu: ThongTinSuKien): SuKien
    + cậpNhậtSựKiện(mãSựKiện: UUID, dữLiệu: ThongTinSuKien): SuKien
    + côngBốSựKiện(mãSựKiện: UUID): SuKien
    + hủySựKiện(mãSựKiện: UUID): void
  }
  class "Dịch vụ suất" as DVSuat {
    + tạoSuất(mãSựKiện: UUID, dữLiệu: ThongTinSuat): SuatSuKien
    + cậpNhậtSuất(mãSuất: UUID, dữLiệu: ThongTinSuat): SuatSuKien
    + mởĐăngKý(mãSuất: UUID): void
    + đóngĐăngKý(mãSuất: UUID): void
  }
  class "Dịch vụ hỗ trợ tiếp cận" as DVHoTro {
    + gánĐặcTínhChoSựKiện(mãSựKiện: UUID, danhSáchĐặcTính: UUID[]): void
    + tìmSựKiệnTheoĐặcTính(mãĐặcTính: UUID): SuKien[]
  }
  DVSuKien --> DVSuat
  DVSuKien --> DVHoTro
}

package "Đăng ký và vé" {
  class "Dịch vụ đăng ký" as DVDangKy {
    + đăngKý(mãNgườiThamDự: UUID, mãSuất: UUID): DangKy
    + hủyĐăngKý(mãNgườiThamDự: UUID, mãĐăngKý: UUID): void
  }
  class "Dịch vụ chống bot" as DVChongBot {
    + kiểmTraYêuCầuĐăngKý(mãNgườiThamDự: UUID, mãSuất: UUID): void
  }
  class "Dịch vụ phân bổ" as DVPhanBo {
    + phânBổNgay(mãNgườiThamDự: UUID, mãSuất: UUID): TrangThaiDangKy
    + chạyPhânBổ(mãSuất: UUID, mãNgườiThựcHiện: UUID): LanPhanBo
  }
  class "Dịch vụ danh sách chờ" as DVDanhSachCho {
    + thêmVàoDanhSách(mãĐăngKý: UUID): DanhSachCho
    + chọnNgườiTiếpTheo(mãSuất: UUID): DangKy?
    + hủyMụcChờ(mãĐăngKý: UUID): void
  }
  class "Dịch vụ vé" as DVVe {
    + phátVé(mãĐăngKý: UUID): Ve
    + hủyVé(mãĐăngKý: UUID): void
    + tìmTheoMã(mãVé: string): Ve
  }
  class "Dịch vụ check-in" as DVCheckIn {
    + checkIn(mãNhânViên: UUID, mãSuất: UUID, mãVé: string): LuotCheckIn
  }

  DVDangKy --> DVChongBot
  DVDangKy --> DVPhanBo
  DVPhanBo --> DVDanhSachCho
  DVPhanBo --> DVVe
  DVDangKy --> DVVe
  DVCheckIn --> DVVe

  DVDangKy -[hidden]right- DVPhanBo
  DVPhanBo -[hidden]right- DVVe
  DVChongBot -[hidden]right- DVDanhSachCho
  DVDanhSachCho -[hidden]right- DVCheckIn
}

DVSuat --> DVDangKy : hủy dây chuyền
@enduml
