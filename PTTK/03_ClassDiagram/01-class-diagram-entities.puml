@startuml
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 13
skinparam nodesep 50
skinparam ranksep 55
hide circle
hide stereotypes

title MED-06 - CLASS DIAGRAM: DOMAIN ENTITIES

class User {
  - id: UUID
  - fullName: string
  - email: string
  - role: UserRole
  - status: AccountStatus
  + isActive(): boolean
}
class Venue {
  - id: UUID
  - name: string
  - capacity: int
  + canHost(capacity: int): boolean
}
class AccessibilityFeature {
  - id: UUID
  - name: string
}
class Event {
  - id: UUID
  - name: string
  - status: EventStatus
  + canPublish(): boolean
  + publish(): void
  + cancel(): void
}
class EventSession {
  - id: UUID
  - startTime: DateTime
  - capacity: int
  - allocationPolicy: AllocationPolicy
  - status: SessionStatus
  + isRegistrationOpen(now): boolean
  + availableSlots(confirmedCount): int
}
class AllocationRun {
  - id: UUID
  - policy: AllocationPolicy
  - executedAt: DateTime
}
class Registration {
  - id: UUID
  - registeredAt: DateTime
  - status: RegistrationStatus
  + confirm(): void
  + markWaitlisted(): void
  + cancel(): void
}
class WaitlistEntry {
  - id: UUID
  - position: long
  - status: WaitlistStatus
  + promote(): void
}
class Ticket {
  - id: UUID
  - ticketCode: string
  - status: TicketStatus
  + canCheckIn(): boolean
  + markUsed(): void
  + cancel(): void
}
class CheckIn {
  - id: UUID
  - checkedInAt: DateTime
  - method: CheckInMethod
}

Venue "1" -- "0..*" Event : hosts
User "1" -- "0..*" Event : organizes
Event "1" *-- "0..*" EventSession
Event "0..*" -- "0..*" AccessibilityFeature
EventSession "1" -- "0..*" Registration
User "1" -- "0..*" Registration
EventSession "1" *-- "0..1" AllocationRun
Registration "1" *-- "0..1" WaitlistEntry
Registration "1" *-- "0..1" Ticket
Ticket "1" *-- "0..1" CheckIn

User -[hidden]right- Venue
Venue -[hidden]right- AccessibilityFeature
EventSession -[hidden]right- AllocationRun
WaitlistEntry -[hidden]right- Ticket
Ticket -[hidden]right- CheckIn

@enduml
