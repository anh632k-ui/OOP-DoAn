@startuml
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 13
skinparam nodesep 50
skinparam ranksep 55
hide circle
hide stereotypes

title MED-06 - BIỂU ĐỒ LỚP: CÁC LỚP NGHIỆP VỤ

class "Người dùng" as NguoiDung {
  - mã: UUID
  - họTên: string
  - email: string
  - vaiTrò: VaiTroNguoiDung
  - trạngThái: TrangThaiTaiKhoan
  + đangHoạtĐộng(): boolean
}
class "Địa điểm" as DiaDiem {
  - mã: UUID
  - tên: string
  - sứcChứa: int
  + đủSứcChứa(sốNgười: int): boolean
}
class "Đặc tính hỗ trợ tiếp cận" as HoTroTiepCan {
  - mã: UUID
  - tên: string
}
class "Sự kiện" as SuKien {
  - mã: UUID
  - tên: string
  - trạngThái: TrangThaiSuKien
  + cóThểCôngBố(): boolean
  + côngBố(): void
  + hủy(): void
}
class "Suất sự kiện" as SuatSuKien {
  - mã: UUID
  - thờiGianBắtĐầu: DateTime
  - sứcChứa: int
  - chínhSáchPhânBổ: ChinhSachPhanBo
  - trạngThái: TrangThaiSuat
  + đangMởĐăngKý(thờiĐiểm): boolean
  + sốChỗCònLại(đãXácNhận): int
}
class "Lần phân bổ" as LanPhanBo {
  - mã: UUID
  - chínhSách: ChinhSachPhanBo
  - thờiĐiểmThựcHiện: DateTime
}
class "Đăng ký" as DangKy {
  - mã: UUID
  - thờiĐiểmĐăngKý: DateTime
  - trạngThái: TrangThaiDangKy
  + xácNhận(): void
  + đưaVàoDanhSáchChờ(): void
  + hủy(): void
}
class "Mục danh sách chờ" as DanhSachCho {
  - mã: UUID
  - thứTự: long
  - trạngThái: TrangThaiDanhSachCho
  + chọnLên(): void
}
class "Vé" as Ve {
  - mã: UUID
  - mãVé: string
  - trạngThái: TrangThaiVe
  + cóThểCheckIn(): boolean
  + đánhDấuĐãDùng(): void
  + hủy(): void
}
class "Lượt check-in" as LuotCheckIn {
  - mã: UUID
  - thờiĐiểmCheckIn: DateTime
  - phươngThức: PhuongThucCheckIn
}

DiaDiem "1" -- "0..*" SuKien : tổ chức tại
NguoiDung "1" -- "0..*" SuKien : tổ chức
SuKien "1" *-- "0..*" SuatSuKien
SuKien "0..*" -- "0..*" HoTroTiepCan
SuatSuKien "1" -- "0..*" DangKy
NguoiDung "1" -- "0..*" DangKy
SuatSuKien "1" *-- "0..1" LanPhanBo
DangKy "1" *-- "0..1" DanhSachCho
DangKy "1" *-- "0..1" Ve
Ve "1" *-- "0..1" LuotCheckIn

NguoiDung -[hidden]right- DiaDiem
DiaDiem -[hidden]right- HoTroTiepCan
SuatSuKien -[hidden]right- LanPhanBo
DanhSachCho -[hidden]right- Ve
Ve -[hidden]right- LuotCheckIn
@enduml
