@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13

title MED-06 - ACTIVITY UC05: ĐĂNG KÝ MỘT SUẤT

|Attendee|
start
:Chọn EventSession;
:Gửi yêu cầu đăng ký;

|Hệ thống|
:Kiểm tra tài khoản, anti-bot,
duplicate và registration window;

if (Yêu cầu hợp lệ?) then (Có)
else (Không)
  :Từ chối đăng ký;
  |Attendee|
  :Nhận thông báo lỗi;
  stop
endif

if (AllocationPolicy = FCFS?) then (Có)
  :Khóa EventSession trong transaction;
  :Tạo Registration PENDING;
  :Kiểm tra số chỗ còn lại;

  if (Còn chỗ?) then (Có)
    :Registration -> CONFIRMED;
    :Phát Ticket VALID;
    |Attendee|
    :Nhận vé điện tử;
  else (Không)
    :Registration -> WAITLISTED;
    :Tạo WaitlistEntry ACTIVE;
    |Attendee|
    :Nhận vị trí waitlist;
  endif

else (LOTTERY)
  :Tạo Registration PENDING;
  |Attendee|
  :Chờ AllocationRun sau khi đóng đăng ký;
endif

stop
@enduml
