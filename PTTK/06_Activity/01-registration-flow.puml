@startuml
skinparam shadowing false

title MED-06 - ACTIVITY ĐĂNG KÝ SUẤT (UC05)

start
:Attendee chọn EventSession;
:Gửi yêu cầu đăng ký;

if (Tài khoản ACTIVE?) then (Có)
else (Không)
  :Từ chối yêu cầu;
  stop
endif

if (Vượt rate limit?) then (Có)
  :Từ chối do anti-bot;
  stop
else (Không)
endif

if (Đã có Registration cùng session?) then (Có)
  :Từ chối đăng ký trùng;
  stop
else (Không)
endif

if (Đúng cửa sổ đăng ký\nvà session cho phép đăng ký?) then (Có)
else (Không)
  :Từ chối do session/window không hợp lệ;
  stop
endif

:Tạo Registration = PENDING;

if (AllocationPolicy = FCFS?) then (Có)
  :Khóa session / bảo vệ transaction;
  :Đếm Registration CONFIRMED;
  if (confirmed < capacity?) then (Còn chỗ)
    :Registration -> CONFIRMED;
    :Phát Ticket VALID;
    :Trả kết quả đăng ký thành công;
  else (Hết chỗ)
    :Registration -> WAITLISTED;
    :Tạo WaitlistEntry;
    :Trả vị trí waitlist;
  endif
else (LOTTERY)
  :Giữ Registration = PENDING;
  :Chờ đóng đăng ký và AllocationRun;
endif

stop
@enduml
