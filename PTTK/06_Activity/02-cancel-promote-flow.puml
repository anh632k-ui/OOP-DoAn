@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13

title MED-06 - ACTIVITY UC06: HỦY ĐĂNG KÝ + PROMOTE WAITLIST

|Attendee|
start
:Yêu cầu hủy Registration;

|Hệ thống|
:Kiểm tra ownership,
trạng thái Session và Ticket;

if (Được phép hủy?) then (Có)
else (Không)
  :Từ chối yêu cầu;
  |Attendee|
  :Nhận thông báo lỗi;
  stop
endif

if (Registration = PENDING?) then (Có)
  :Registration -> CANCELLED;

else (Không)
  if (Registration = WAITLISTED?) then (Có)
    :Registration -> CANCELLED;
    :WaitlistEntry -> CANCELLED;

  else (CONFIRMED)
    :Khóa EventSession trong transaction;
    :Registration -> CANCELLED;
    :Ticket VALID -> CANCELLED;

    if (Waitlist còn ACTIVE entry?) then (Có)
      :Lấy entry đầu tiên;
      :Registration chờ -> CONFIRMED;
      :WaitlistEntry -> PROMOTED;
      :Phát Ticket VALID mới;
    else (Không)
      :Giữ slot trống;
    endif

    :Commit transaction;
  endif
endif

|Attendee|
:Nhận xác nhận đã hủy;
stop
@enduml
