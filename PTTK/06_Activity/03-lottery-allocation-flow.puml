@startuml
skinparam shadowing false

title MED-06 - ACTIVITY LOTTERY ALLOCATION (UC12)

start
:Organizer yêu cầu chạy AllocationRun;
:Kiểm tra ownership EventSession;

if (Policy = LOTTERY\nvà registration đã đóng?) then (Có)
else (Không)
  :Từ chối chạy allocation;
  stop
endif

:Khóa EventSession;

if (Đã có AllocationRun đã commit?) then (Có)
  :Từ chối chạy lặp;
  stop
else (Không)
endif

:Lấy Registration PENDING hợp lệ;
:Đếm số Registration CONFIRMED hiện tại;
:Tính số slot còn lại;
:Tạo thứ tự ngẫu nhiên công bằng;

if (Còn slot?) then (Có)
  :Chọn tối đa slot ứng viên đầu;
  :Đổi sang CONFIRMED;
  :Phát Ticket VALID cho từng người;
else (Không)
endif

:Các ứng viên còn lại -> WAITLISTED;
:Tạo WaitlistEntry theo draw position;
:Ghi AllocationRun + executedBy + metadata audit;
:Commit transaction;
:Trả kết quả cho Organizer;
stop
@enduml
