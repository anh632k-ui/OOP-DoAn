@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
hide footbox

title MED-06 - SEQUENCE UC06: HỦY ĐĂNG KÝ + PROMOTE WAITLIST

actor Attendee
boundary "Next.js UI" as UI
control "RegistrationService" as RS
control "TicketService" as TS
control "WaitlistService" as WS
database "PostgreSQL" as DB

autonumber
Attendee -> UI : Chọn Hủy đăng ký
UI -> RS : cancelRegistration(attendeeId, registrationId)
RS -> DB : tải Registration + Session + Ticket
DB --> RS : dữ liệu hiện tại
RS -> RS : kiểm tra ownership + điều kiện hủy

alt Registration = PENDING
  RS -> DB : Registration -> CANCELLED

else Registration = WAITLISTED
  group Transaction
    RS -> DB : Registration -> CANCELLED
    RS -> WS : cancelEntry(registrationId)
    WS -> DB : WaitlistEntry -> CANCELLED
  end

else Registration = CONFIRMED
  group Transaction + lock EventSession
    RS -> DB : lock session + Registration -> CANCELLED
    RS -> TS : cancelTicket(registrationId)
    TS -> DB : Ticket VALID -> CANCELLED

    RS -> WS : promoteNext(sessionId)
    WS -> DB : lấy WaitlistEntry ACTIVE đầu tiên FOR UPDATE

    alt có người chờ
      DB --> WS : next entry
      WS -> DB : Registration chờ -> CONFIRMED
      WS -> DB : WaitlistEntry -> PROMOTED
      WS -> TS : issueTicket(nextRegistrationId)
      TS -> DB : tạo Ticket VALID
      WS --> RS : promoted
    else không còn người chờ
      DB --> WS : none
      WS --> RS : none
    end
  end
end

RS --> UI : 204 No Content
UI --> Attendee : Đã hủy đăng ký

note over RS,DB
Chỉ hủy CONFIRMED mới giải phóng slot và kích hoạt promote.
Hủy + hủy Ticket + promote phải commit atomically.
end note

@enduml
