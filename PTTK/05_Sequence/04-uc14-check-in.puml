@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
hide footbox

title MED-06 - SEQUENCE UC14: CHECK-IN VÉ

actor "Check-in Staff" as Staff
boundary "Check-in UI" as UI
control "CheckInService" as CS
database "PostgreSQL" as DB

autonumber
Staff -> UI : Quét QR / nhập ticketCode
UI -> CS : checkIn(staffId, sessionId, ticketCode)

CS -> DB : lock Ticket theo ticketCode
DB --> CS : Ticket
CS -> DB : tải EventSession + kiểm tra CheckIn hiện có
DB --> CS : session + check-in status
CS -> CS : validate đúng session + Ticket = VALID

alt hợp lệ và chưa dùng
  group Transaction
    CS -> DB : tạo CheckIn
    CS -> DB : Ticket -> USED
  end
  CS --> UI : success
  UI --> Staff : Cho phép vào sự kiện
else không hợp lệ / đã dùng / sai session
  CS --> UI : domain error
  UI --> Staff : Từ chối check-in
end

note over CS,DB
Row lock + UNIQUE(check_ins.ticket_id) bảo đảm một Ticket chỉ check-in một lần.
end note

@enduml
