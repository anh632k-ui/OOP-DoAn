@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequence {
  ArrowColor #C05773
  LifeLineBorderColor #C05773
  ParticipantBackgroundColor #FFF8CE
  ParticipantBorderColor #C05773
  ActorBorderColor #C05773
}
hide footbox
autonumber
title MED-06 - TUẦN TỰ UC14: CHECK-IN MỘT VÉ
actor "Nhân viên check-in" as A
boundary "Trang check-in" as UI
control "Dịch vụ check-in" as CI
entity "Vé" as VE
entity "Lượt check-in" as LK
database "PostgreSQL" as DB
A -> UI : Quét QR / nhập mã vé
UI -> CI : checkIn(mãNhânViên, mãSuất, mãVé)
activate CI
CI -> VE : tìmTheoMã(mãVé)
VE -> DB : SELECT FOR UPDATE vé
DB --> VE : vé + trạng thái
VE --> CI : thông tin vé
CI -> DB : kiểm tra suất, lượt check-in
DB --> CI : dữ liệu liên quan
alt Vé không tồn tại / sai suất / đã dùng / hết hạn
  CI --> UI : lỗi nghiệp vụ (404 / 409)
  UI --> A : Từ chối check-in
else Vé hợp lệ
  group Giao dịch
    CI -> LK : ghi nhận lượt check-in
    LK -> DB : INSERT check_in
    CI -> VE : đánhDấuĐãDùng()
    VE -> DB : UPDATE vé ĐÃ_SỬ_DỤNG
  end
  CI --> UI : Check-in thành công
  UI --> A : Cho phép vào cổng
end
deactivate CI
note over VE,DB
Khóa dòng vé + UNIQUE(check_in.ma_ve)
để hai lần quét chỉ một lần thành công.
end note
@enduml
