@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequence {
  ArrowColor #C05773
  LifeLineBorderColor #C05773
  ParticipantBackgroundColor #FFF8CE
  ParticipantBorderColor #C05773
  ActorBorderColor #C05773
}
hide footbox
autonumber
title MED-06 - TUẦN TỰ UC09: TẠO SỰ KIỆN VÀ SUẤT
actor "Ban tổ chức" as A
boundary "Trang quản lý sự kiện" as UI
control "Dịch vụ sự kiện" as SK
control "Dịch vụ suất" as SU
entity "Sự kiện" as ENT
entity "Suất sự kiện" as ENT_SU
database "PostgreSQL" as DB
A -> UI : Nhập thông tin sự kiện
UI -> SK : tạoSựKiện(mãNgườiTổChức, dữLiệu)
activate SK
SK -> DB : kiểm tra quyền, địa điểm, thời gian
DB --> SK : dữ liệu tham chiếu
alt Dữ liệu không hợp lệ
  SK --> UI : lỗi và thông tin cần sửa
  UI --> A : Hiển thị thông báo
else Hợp lệ
  SK -> ENT : tạo Sự kiện NHÁP
  ENT -> DB : INSERT su_kien
  DB --> ENT : mã sự kiện
  ENT --> SK : sự kiện đã tạo
  SK --> UI : Sự kiện NHÁP
  UI --> A : Hiển thị sự kiện
  opt Ban tổ chức thêm suất
    A -> UI : Nhập lịch, sức chứa, chính sách
    UI -> SU : tạoSuất(mãSựKiện, dữLiệuSuất)
    SU -> DB : kiểm tra quyền sở hữu, lịch, sức chứa
    alt Suất không hợp lệ
      SU --> UI : lỗi dữ liệu suất
    else Hợp lệ
      SU -> ENT_SU : tạo suất NHÁP
      ENT_SU -> DB : INSERT suat_su_kien
      SU --> UI : Suất đã lưu
    end
    UI --> A : Hiển thị kết quả
  end
end
deactivate SK
note over SK,ENT_SU
Tạo sự kiện NHÁP không bắt buộc có suất;
công bố (UC11) mới đòi >= 1 suất hợp lệ.
end note
@enduml
