@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
hide footbox

title MED-06 - SEQUENCE UC09: TẠO SỰ KIỆN VÀ THIẾT LẬP BAN ĐẦU

actor Organizer
boundary "Organizer UI" as UI
control "EventService" as ES
control "SessionService" as SS
control "AccessibilityService" as ACS
database "PostgreSQL" as DB
cloud "Object Storage" as OS

autonumber
Organizer -> UI : Nhập thông tin Event

opt Có ảnh sự kiện
  UI -> OS : upload image
  OS --> UI : imageUrl
end

UI -> ES : createEvent(organizerId, eventData, imageUrl)
ES -> ES : validate venue/date/basic data
ES -> DB : tạo Event DRAFT
DB --> ES : Event
ES --> UI : Event DRAFT

Organizer -> UI : Thêm EventSession
UI -> SS : createSession(eventId, organizerId, sessionData)
SS -> DB : kiểm tra ownership Event
DB --> SS : Event DRAFT
SS -> SS : validate time/capacity/window/policy
SS -> DB : tạo EventSession DRAFT
DB --> SS : EventSession
SS --> UI : EventSession

opt Khai báo accessibility
  Organizer -> UI : Chọn AccessibilityFeature
  UI -> ACS : setEventFeatures(eventId, organizerId, featureIds)
  ACS -> DB : kiểm tra ownership + thay danh sách feature
  DB --> ACS : success
  ACS --> UI : success
end

UI --> Organizer : Hiển thị Event DRAFT đã thiết lập

note over ES,SS
Event DRAFT có thể chưa có Session.
UC11 chỉ publish khi có ít nhất một EventSession hợp lệ.
end note

@enduml
