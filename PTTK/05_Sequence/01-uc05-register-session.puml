@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
hide footbox

title MED-06 - SEQUENCE UC05: ĐĂNG KÝ MỘT SUẤT

actor Attendee
boundary "Next.js UI" as UI
control "RegistrationService" as RS
control "BotProtectionService" as BP
control "AllocationService" as AS
control "WaitlistService" as WS
control "TicketService" as TS
database "PostgreSQL" as DB

autonumber
Attendee -> UI : Chọn suất và nhấn Đăng ký
UI -> RS : register(attendeeId, sessionId)
RS -> BP : validateRegistrationRequest(...)
BP -> DB : kiểm tra account + rate limit + duplicate
DB --> BP : hợp lệ
BP --> RS : valid

RS -> DB : đọc EventSession + registration window
DB --> RS : session

alt FCFS
  group Transaction + lock EventSession
    RS -> AS : allocateImmediate(attendeeId, sessionId)
    AS -> DB : lock session + tạo Registration PENDING
    AS -> DB : đếm CONFIRMED

    alt còn chỗ
      AS -> DB : Registration -> CONFIRMED
      AS -> TS : issueTicket(registrationId)
      TS -> DB : tạo Ticket VALID
      TS --> AS : Ticket
      AS --> RS : CONFIRMED
    else hết chỗ
      AS -> DB : Registration -> WAITLISTED
      AS -> WS : enqueue(registrationId)
      WS -> DB : tạo WaitlistEntry ACTIVE
      WS --> AS : waitlist position
      AS --> RS : WAITLISTED
    end
  end

else LOTTERY
  RS -> DB : tạo Registration PENDING
  DB --> RS : Registration
end

RS --> UI : trạng thái Registration (+ Ticket/position nếu có)
UI --> Attendee : Hiển thị kết quả

note over BP,DB
UNIQUE(attendee_id, session_id) là lớp bảo vệ cuối cho duplicate.
end note

note over AS,DB
FCFS phải khóa session trong transaction để không oversell.
end note

@enduml
