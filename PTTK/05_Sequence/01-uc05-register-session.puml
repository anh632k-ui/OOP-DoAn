@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequence {
  ArrowColor #C05773
  LifeLineBorderColor #C05773
  ParticipantBackgroundColor #FFF8CE
  ParticipantBorderColor #C05773
  ActorBorderColor #C05773
}
hide footbox
autonumber
title MED-06 - TUẦN TỰ UC05: ĐĂNG KÝ MỘT SUẤT
actor "Người tham dự" as A
boundary "Trang đăng ký" as UI
control "Dịch vụ đăng ký" as DK
control "Dịch vụ chống bot" as CB
control "Dịch vụ phân bổ" as PB
entity "Đăng ký" as ENT
database "PostgreSQL" as DB
A -> UI : Chọn suất, nhấn Đăng ký
UI -> DK : đăngKý(mãNgườiThamDự, mãSuất)
activate DK
DK -> CB : kiểmTraYêuCầuĐăngKý(mãNgườiThamDự, mãSuất)
CB -> DB : kiểm tra tài khoản, tốc độ, trùng
DB --> CB : kết quả kiểm tra
alt Không hợp lệ / đăng ký trùng
  CB --> DK : lỗi (401 / 409 / 429)
  DK --> UI : thông báo từ chối
  UI --> A : Hiển thị lý do
else Hợp lệ
  CB --> DK : cho phép
  DK -> DB : đọc suất, cửa sổ, sức chứa, chính sách
  DB --> DK : dữ liệu suất
  alt Suất không mở đăng ký
    DK --> UI : lỗi (409)
    UI --> A : Không thể đăng ký
  else FCFS
    group Giao dịch khóa suất
      DK -> PB : phânBổNgay(mãNgườiThamDự, mãSuất)
      PB -> ENT : tạo đăng ký CHỜ_XỬ_LÝ
      ENT -> DB : INSERT đăng ký
      PB -> DB : khóa suất, đếm số đã xác nhận
      alt Còn chỗ
        PB -> ENT : xácNhận()
        ENT -> DB : UPDATE trạng thái
        PB -> DB : INSERT vé HỢP_LỆ
      else Hết chỗ
        PB -> ENT : đưaVàoDanhSáchChờ()
        ENT -> DB : UPDATE + INSERT danh_sach_cho
      end
    end
    PB --> DK : trạng thái và vé / số thứ tự
    DK --> UI : kết quả FCFS
    UI --> A : Hiển thị vé hoặc danh sách chờ
  else LOTTERY
    DK -> ENT : tạo đăng ký CHỜ_XỬ_LÝ
    ENT -> DB : INSERT đăng ký
    DB --> DK : đã lưu
    DK --> UI : đang chờ phân bổ
    UI --> A : Hiển thị trạng thái CHỜ_XỬ_LÝ
  end
end
deactivate DK
note over PB,DB
UNIQUE(người tham dự, suất);
FCFS phải khóa dữ liệu và dùng giao dịch.
end note
@enduml
