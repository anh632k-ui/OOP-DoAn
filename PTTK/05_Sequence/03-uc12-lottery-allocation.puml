@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
hide footbox

title MED-06 - SEQUENCE UC12: PHÂN BỔ VÉ LOTTERY

actor Organizer
boundary "Organizer UI" as UI
control "AllocationService" as AS
control "LotteryAllocationStrategy" as LS
control "TicketService" as TS
control "WaitlistService" as WS
database "PostgreSQL" as DB

autonumber
Organizer -> UI : Chọn Chạy phân bổ
UI -> AS : runAllocation(sessionId, organizerId)

group Transaction + lock EventSession
  AS -> DB : lock session + kiểm tra ownership/policy/window
  DB --> AS : EventSession LOTTERY
  AS -> DB : kiểm tra AllocationRun đã tồn tại
  DB --> AS : chưa có
  AS -> DB : lấy PENDING candidates + confirmedCount
  DB --> AS : candidates[] + confirmedCount

  AS -> LS : allocate(session, candidates, confirmedCount)
  LS --> AS : AllocationPlan

  loop registrations được chọn
    AS -> DB : status -> CONFIRMED
    AS -> TS : issueTicket(registrationId)
    TS -> DB : tạo Ticket VALID
  end

  loop registrations còn lại theo draw order
    AS -> DB : status -> WAITLISTED
    AS -> WS : enqueue(registrationId, drawPosition)
    WS -> DB : tạo WaitlistEntry ACTIVE
  end

  AS -> DB : tạo AllocationRun + metadata audit
end

AS --> UI : summary(confirmed, waitlisted)
UI --> Organizer : Hiển thị kết quả phân bổ

note over AS,DB
Row lock + UNIQUE(allocation_runs.session_id) bảo đảm chỉ một Lottery run commit.
Lỗi giữa chừng => rollback toàn bộ.
end note

note over AS,LS
Strategy chỉ tính AllocationPlan; không tự ghi DB.
end note

@enduml
