@startuml
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

title MED-06 - SEQUENCE UC12 PHÂN BỔ VÉ LOTTERY

actor Organizer
boundary "Next.js Organizer UI" as UI
control "AllocationController" as AC
control "AllocationService" as AS
entity "EventSessionRepository" as ESR
entity "RegistrationRepository" as RR
control "LotteryAllocationStrategy" as LAS
control "TicketService" as TS
control "WaitlistService" as WS
entity "AllocationRunRepository" as ARR

autonumber
Organizer -> UI : Chọn chạy phân bổ vé
UI -> AC : POST /sessions/{id}/allocation
AC -> AS : runAllocation(sessionId, organizerId)
AS -> ESR : findOwnedSessionForUpdate(sessionId, organizerId)
ESR --> AS : EventSession locked
AS -> AS : kiểm tra registration đã đóng\nvà policy = LOTTERY
AS -> ARR : existsCompletedRun(sessionId)
ARR --> AS : false
AS -> RR : findPendingEligible(sessionId)
RR --> AS : candidates[]
AS -> RR : countConfirmed(sessionId)
RR --> AS : confirmedCount
AS -> LAS : allocate(session, candidates, confirmedCount)
LAS -> LAS : shuffle công bằng + xác định slot
LAS --> AS : AllocationPlan

loop mỗi registration được xác nhận
  AS -> RR : updateStatus(id, CONFIRMED)
  AS -> TS : issueTicket(id)
  TS --> AS : Ticket VALID
end

loop mỗi registration còn lại
  AS -> RR : updateStatus(id, WAITLISTED)
  AS -> WS : enqueueInDrawOrder(id)
  WS --> AS : WaitlistEntry
end

AS -> ARR : create(sessionId, policy, counts, metadata)
ARR --> AS : AllocationRun
AS --> AC : AllocationRun result
AC --> UI : 200 + summary
UI --> Organizer : Hiển thị số trúng / waitlist

note over AS,ARR
Các bước update Registration, phát Ticket, tạo WaitlistEntry
và ghi AllocationRun phải commit atomically.
Nếu lỗi giữa chừng thì rollback toàn bộ run.
end note

note right of LAS
Strategy chỉ tính AllocationPlan.
Nó không tự ghi DB.
Application service chịu trách nhiệm orchestration + transaction.
end note

@enduml
