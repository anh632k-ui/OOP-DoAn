@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequence {
  ArrowColor #C05773
  LifeLineBorderColor #C05773
  ParticipantBackgroundColor #FFF8CE
  ParticipantBorderColor #C05773
  ActorBorderColor #C05773
}
hide footbox
autonumber
title MED-06 - TUẦN TỰ UC12: PHÂN BỔ LOTTERY
actor "Ban tổ chức" as A
boundary "Trang quản lý suất" as UI
control "Dịch vụ phân bổ" as PB
control "Chiến lược bốc thăm" as CL
entity "Lần phân bổ" as ENT
database "PostgreSQL" as DB
A -> UI : Bấm Chạy phân bổ
UI -> PB : chạyPhânBổ(mãSuất, mãNgườiThựcHiện)
activate PB
PB -> DB : khóa suất; kiểm tra quyền, chính sách, thời gian
DB --> PB : suất và trạng thái
alt Không đủ quyền / chưa đóng / không phải LOTTERY
  PB --> UI : lỗi điều kiện
  UI --> A : Từ chối phân bổ
else Đủ điều kiện
  PB -> DB : kiểm tra đã có lần phân bổ
  alt Đã chạy LOTTERY trước đó
    DB --> PB : đã có
    PB --> UI : 409 - không chạy lần thứ hai
    UI --> A : Hiển thị thông báo
  else Chưa chạy
    DB --> PB : chưa có
    group Giao dịch khóa suất
      PB -> DB : tải ứng viên CHỜ_XỬ_LÝ và số chỗ trống
      DB --> PB : danh sách hợp lệ
      PB -> CL : phânBổ(suất, ứngViên, sốĐãXácNhận)
      CL --> PB : Kế hoạch phân bổ
      loop Mỗi người trúng
        PB -> DB : UPDATE ĐÃ_XÁC_NHẬN + INSERT vé
      end
      loop Mỗi người không trúng
        PB -> DB : UPDATE DANH_SÁCH_CHỜ + INSERT mục chờ
      end
      PB -> ENT : ghi nhận kết quả / người thực hiện
      ENT -> DB : INSERT lan_phan_bo và dữ liệu kiểm chứng
    end
    PB --> UI : số vé, số chờ
    UI --> A : Hiển thị kết quả
  end
end
deactivate PB
note over PB,DB
UNIQUE(lan_phan_bo.ma_suat); lỗi giữa
giao dịch phải ROLLBACK toàn bộ.
end note
@enduml
