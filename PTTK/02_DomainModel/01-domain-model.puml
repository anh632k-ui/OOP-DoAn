@startuml
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 14
skinparam nodesep 55
skinparam ranksep 55
hide methods
hide circle

title MED-06 - DOMAIN MODEL CORE

class User {
  id
  fullName
  role
}
class Venue {
  id
  name
  capacity
}
class AccessibilityFeature {
  id
  name
}
class Event {
  id
  name
  status
}
class EventSession {
  id
  startTime
  capacity
  allocationPolicy
  status
}
class AllocationRun {
  id
  policy
  executedAt
}
class Registration {
  id
  registeredAt
  status
}
class WaitlistEntry {
  id
  position
  status
}
class Ticket {
  id
  ticketCode
  status
}
class CheckIn {
  id
  checkedInAt
}

Venue "1" -- "0..*" Event : hosts
User "1" -- "0..*" Event : organizes
Event "1" *-- "0..*" EventSession : contains
Event "0..*" -- "0..*" AccessibilityFeature : supports
EventSession "1" -- "0..*" Registration : receives
User "1" -- "0..*" Registration : submits
Registration "1" -- "0..1" WaitlistEntry : waitlist
Registration "1" -- "0..1" Ticket : ticket
Ticket "1" -- "0..1" CheckIn : check-in
EventSession "1" -- "0..1" AllocationRun : lottery audit

' Layout helpers only.
User -[hidden]right- Venue
Venue -[hidden]right- AccessibilityFeature
EventSession -[hidden]right- AllocationRun
WaitlistEntry -[hidden]right- Ticket
Ticket -[hidden]right- CheckIn

@enduml
