@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 14
hide methods
hide circle

title MED-06 - MÔ HÌNH MIỀN

class "Người dùng" as NguoiDung {
  họTên
  vaiTrò
}
class "Địa điểm" as DiaDiem {
  tên
  sứcChứa
}
class "Đặc tính hỗ trợ tiếp cận" as HoTroTiepCan {
  tên
}
class "Sự kiện" as SuKien {
  tên
  trạngThái
}
class "Suất sự kiện" as SuatSuKien {
  thờiGianBắtĐầu
  sứcChứa
  chínhSáchPhânBổ
  trạngThái
}
class "Lần phân bổ" as LanPhanBo {
  chínhSách
  thờiĐiểmThựcHiện
}
class "Đăng ký" as DangKy {
  thờiĐiểmĐăngKý
  trạngThái
}
class "Mục danh sách chờ" as DanhSachCho {
  thứTự
  trạngThái
}
class "Vé" as Ve {
  mãVé
  trạngThái
}
class "Lượt check-in" as LuotCheckIn {
  thờiĐiểmCheckIn
}

DiaDiem "1" -- "0..*" SuKien : tổ chức tại
NguoiDung "1" -- "0..*" SuKien : tổ chức
SuKien "1" *-- "0..*" SuatSuKien : gồm
SuKien "0..*" -- "0..*" HoTroTiepCan : hỗ trợ
SuatSuKien "1" -- "0..*" DangKy : nhận đăng ký
NguoiDung "1" -- "0..*" DangKy : thực hiện
DangKy "1" -- "0..1" DanhSachCho : danh sách chờ
DangKy "1" -- "0..1" Ve : cấp vé
Ve "1" -- "0..1" LuotCheckIn : check-in
SuatSuKien "1" -- "0..1" LanPhanBo : ghi nhận phân bổ

NguoiDung -[hidden]right- DiaDiem
DiaDiem -[hidden]right- HoTroTiepCan
SuatSuKien -[hidden]right- LanPhanBo
DanhSachCho -[hidden]right- Ve
Ve -[hidden]right- LuotCheckIn
@enduml
