@startuml
left to right direction
hide methods
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 45

title MED-06 - DOMAIN MODEL CORE

class User {
  id
  fullName
  role
}

class Venue {
  id
  name
  capacity
}

class Event {
  id
  name
  status
}

class EventSession {
  id
  startTime
  capacity
  allocationPolicy
  status
}

class Registration {
  id
  registeredAt
  status
}

class WaitlistEntry {
  id
  position
  status
}

class Ticket {
  id
  ticketCode
  status
}

class CheckIn {
  id
  checkedInAt
}

class AccessibilityFeature {
  id
  name
}

class AllocationRun {
  id
  policy
  executedAt
}

User "1" -- "0..*" Event : organizes >
Venue "1" -- "0..*" Event : hosts >
Event "1" *-- "0..*" EventSession : contains >
Event "0..*" -- "0..*" AccessibilityFeature : supports >

User "1" -- "0..*" Registration : submits >
EventSession "1" -- "0..*" Registration : receives >
Registration "1" -- "0..1" WaitlistEntry : waitlist >
Registration "1" -- "0..1" Ticket : ticket >
Ticket "1" -- "0..1" CheckIn : check-in >
User "1" -- "0..*" CheckIn : performs >
EventSession "1" -- "0..1" AllocationRun : lottery audit >
User "1" -- "0..*" AllocationRun : executes >

' Layout helpers
User -[hidden]-> Venue
Venue -[hidden]-> Event
EventSession -[hidden]-> Registration
Registration -[hidden]-> Ticket
Ticket -[hidden]-> CheckIn

@enduml
