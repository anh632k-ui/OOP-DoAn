@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide circle

title MED-06 - DANH MỤC TRẠNG THÁI / KIỂU LIỆT KÊ

package "Người dùng" {
  enum "Vai trò người dùng" as VaiTroNguoiDung {
    NGƯỜI_THAM_DỰ
    BAN_TỔ_CHỨC
    NHÂN_VIÊN
    QUẢN_TRỊ_VIÊN
  }
  enum "Trạng thái tài khoản" as TrangThaiTaiKhoan {
    HOẠT_ĐỘNG
    BỊ_KHÓA
  }
  VaiTroNguoiDung -[hidden]down- TrangThaiTaiKhoan
}

package "Sự kiện và phân bổ" {
  enum "Trạng thái sự kiện" as TrangThaiSuKien {
    NHÁP
    ĐÃ_CÔNG_BỐ
    HOÀN_THÀNH
    ĐÃ_HỦY
  }
  enum "Trạng thái suất" as TrangThaiSuat {
    NHÁP
    ĐANG_MỞ_ĐĂNG_KÝ
    ĐÃ_ĐÓNG_ĐĂNG_KÝ
    ĐANG_DIỄN_RA
    HOÀN_THÀNH
    ĐÃ_HỦY
  }
  enum "Chính sách phân bổ" as ChinhSachPhanBo {
    FCFS
    LOTTERY
  }
  TrangThaiSuKien -[hidden]down- TrangThaiSuat
  TrangThaiSuat -[hidden]down- ChinhSachPhanBo
}

package "Tham dự và vé" {
  enum "Trạng thái đăng ký" as TrangThaiDangKy {
    CHỜ_XỬ_LÝ
    ĐÃ_XÁC_NHẬN
    DANH_SÁCH_CHỜ
    ĐÃ_HỦY
  }
  enum "Trạng thái danh sách chờ" as TrangThaiDanhSachCho {
    ĐANG_CHỜ
    ĐÃ_ĐƯỢC_CHỌN
    ĐÃ_HỦY
  }
  enum "Trạng thái vé" as TrangThaiVe {
    HỢP_LỆ
    ĐÃ_SỬ_DỤNG
    ĐÃ_HỦY
    HẾT_HẠN
  }
  enum "Phương thức check-in" as PhuongThucCheckIn {
    QR
    MÃ_THỦ_CÔNG
  }
  TrangThaiDangKy -[hidden]down- TrangThaiDanhSachCho
  TrangThaiDanhSachCho -[hidden]down- TrangThaiVe
  TrangThaiVe -[hidden]down- PhuongThucCheckIn
}
@enduml
