@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide circle

title MED-06 - DOMAIN ENUM CATALOG

package "Identity" {
  enum UserRole {
    ATTENDEE
    ORGANIZER
    STAFF
    ADMIN
  }
  enum AccountStatus {
    ACTIVE
    LOCKED
  }
  UserRole -[hidden]down- AccountStatus
}

package "Event & Allocation" {
  enum EventStatus {
    DRAFT
    PUBLISHED
    COMPLETED
    CANCELLED
  }
  enum SessionStatus {
    DRAFT
    REGISTRATION_OPEN
    REGISTRATION_CLOSED
    ONGOING
    COMPLETED
    CANCELLED
  }
  enum AllocationPolicy {
    FCFS
    LOTTERY
  }
  EventStatus -[hidden]down- SessionStatus
  SessionStatus -[hidden]down- AllocationPolicy
}

package "Participation" {
  enum RegistrationStatus {
    PENDING
    CONFIRMED
    WAITLISTED
    CANCELLED
  }
  enum WaitlistStatus {
    ACTIVE
    PROMOTED
    CANCELLED
  }
  enum TicketStatus {
    VALID
    USED
    CANCELLED
    EXPIRED
  }
  enum CheckInMethod {
    QR
    MANUAL_CODE
  }
  RegistrationStatus -[hidden]down- WaitlistStatus
  WaitlistStatus -[hidden]down- TicketStatus
  TicketStatus -[hidden]down- CheckInMethod
}

@enduml
