@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 14
hide circle

title MED-06 - ERD: HỖ TRỢ TIẾP CẬN

entity "su_kien" as su_kien {
  * id : UUID <<PK>>
}

entity "su_kien_tiep_can" as su_kien_tiep_can {
  * ma_su_kien : UUID <<PK, FK>>
  * ma_dac_tinh : UUID <<PK, FK>>
}

entity "dac_tinh_tiep_can" as dac_tinh_tiep_can {
  * id : UUID <<PK>>
  --
  ten : VARCHAR(120) <<UQ>>
  mo_ta : TEXT
}

su_kien ||--o{ su_kien_tiep_can
dac_tinh_tiep_can ||--o{ su_kien_tiep_can
@enduml
