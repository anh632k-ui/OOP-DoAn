@startuml
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13
skinparam nodesep 55
skinparam ranksep 55
hide circle

title MED-06 - ERD CORE

entity "users" as users {
  * id : UUID <<PK>>
  --
  email : VARCHAR <<UQ>>
  role : user_role
  status : account_status
}

entity "venues" as venues {
  * id : UUID <<PK>>
  --
  name : VARCHAR
  capacity : INTEGER
}

entity "events" as events {
  * id : UUID <<PK>>
  --
  organizer_id : UUID <<FK>>
  venue_id : UUID <<FK>>
  name : VARCHAR
  status : event_status
}

entity "event_sessions" as sessions {
  * id : UUID <<PK>>
  --
  event_id : UUID <<FK>>
  capacity : INTEGER
  allocation_policy : allocation_policy
  status : session_status
}

entity "registrations" as registrations {
  * id : UUID <<PK>>
  --
  attendee_id : UUID <<FK>>
  session_id : UUID <<FK>>
  status : registration_status
  --
  UQ(attendee_id, session_id)
}

entity "waitlist_entries" as waitlist {
  * id : UUID <<PK>>
  --
  registration_id : UUID <<FK, UQ>>
  position : BIGINT
  status : waitlist_status
}

entity "tickets" as tickets {
  * id : UUID <<PK>>
  --
  registration_id : UUID <<FK, UQ>>
  ticket_code : VARCHAR <<UQ>>
  status : ticket_status
}

entity "check_ins" as checkins {
  * id : UUID <<PK>>
  --
  ticket_id : UUID <<FK, UQ>>
  staff_id : UUID <<FK>>
}

entity "allocation_runs" as runs {
  * id : UUID <<PK>>
  --
  session_id : UUID <<FK, UQ>>
  executed_by_user_id : UUID <<FK>>
  policy : allocation_policy
}

users ||--o{ events : organizes
venues ||--o{ events : hosts
events ||--o{ sessions : contains
users ||--o{ registrations : submits
sessions ||--o{ registrations : receives
registrations ||--o| waitlist : waitlist
registrations ||--o| tickets : ticket
tickets ||--o| checkins : check-in
sessions ||--o| runs : lottery run
users ||--o{ checkins : staff
users ||--o{ runs : executes

' Layout helpers - valid hidden arrows.
users -[hidden]-> venues
sessions -[hidden]-> runs
waitlist -[hidden]-> tickets
tickets -[hidden]-> checkins

@enduml
