@startuml
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13
skinparam nodesep 55
skinparam ranksep 55
hide circle

title MED-06 - ERD CỐT LÕI

entity "nguoi_dung" as nguoi_dung {
  * id : UUID <<PK>>
  --
  email : VARCHAR <<UQ>>
  vai_tro : vai_tro_nguoi_dung
  trang_thai : trang_thai_tai_khoan
}

entity "dia_diem" as dia_diem {
  * id : UUID <<PK>>
  --
  ten : VARCHAR
  suc_chua : INTEGER
}

entity "su_kien" as su_kien {
  * id : UUID <<PK>>
  --
  ma_nguoi_to_chuc : UUID <<FK>>
  ma_dia_diem : UUID <<FK>>
  ten : VARCHAR
  trang_thai : trang_thai_su_kien
}

entity "suat_su_kien" as suat {
  * id : UUID <<PK>>
  --
  ma_su_kien : UUID <<FK>>
  suc_chua : INTEGER
  chinh_sach_phan_bo : chinh_sach_phan_bo
  trang_thai : trang_thai_suat
}

entity "dang_ky" as dang_ky {
  * id : UUID <<PK>>
  --
  ma_nguoi_tham_du : UUID <<FK>>
  ma_suat : UUID <<FK>>
  trang_thai : trang_thai_dang_ky
  --
  UQ(ma_nguoi_tham_du, ma_suat)
}

entity "danh_sach_cho" as danh_sach_cho {
  * id : UUID <<PK>>
  --
  ma_dang_ky : UUID <<FK, UQ>>
  thu_tu : BIGINT
  trang_thai : trang_thai_danh_sach_cho
}

entity "ve" as ve {
  * id : UUID <<PK>>
  --
  ma_dang_ky : UUID <<FK, UQ>>
  ma_ve : VARCHAR <<UQ>>
  trang_thai : trang_thai_ve
}

entity "check_in" as check_in {
  * id : UUID <<PK>>
  --
  ma_ve : UUID <<FK, UQ>>
  ma_nhan_vien : UUID <<FK>>
}

entity "lan_phan_bo" as lan_phan_bo {
  * id : UUID <<PK>>
  --
  ma_suat : UUID <<FK, UQ>>
  ma_nguoi_thuc_hien : UUID <<FK>>
  chinh_sach : chinh_sach_phan_bo
}

nguoi_dung ||--o{ su_kien : tổ chức
dia_diem ||--o{ su_kien : địa điểm
su_kien ||--o{ suat : gồm
nguoi_dung ||--o{ dang_ky : đăng ký
suat ||--o{ dang_ky : nhận
dang_ky ||--o| danh_sach_cho : danh sách chờ
dang_ky ||--o| ve : cấp vé
ve ||--o| check_in : check-in
suat ||--o| lan_phan_bo : lần phân bổ
nguoi_dung ||--o{ check_in : nhân viên
nguoi_dung ||--o{ lan_phan_bo : thực hiện

nguoi_dung -[hidden]-> dia_diem
suat -[hidden]-> lan_phan_bo
danh_sach_cho -[hidden]-> ve
ve -[hidden]-> check_in
@enduml
