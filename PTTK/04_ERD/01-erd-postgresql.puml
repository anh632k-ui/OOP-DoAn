@startuml
hide circle
skinparam shadowing false
skinparam linetype ortho
skinparam entity {
  BackgroundColor White
  BorderColor Black
}

title MED-06 - ERD POSTGRESQL

entity "users" as users {
  * id : UUID <<PK>>
  --
  full_name : VARCHAR(120)
  email : VARCHAR(255) <<UQ>>
  password_hash : VARCHAR(255)
  role : user_role
  status : account_status
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "venues" as venues {
  * id : UUID <<PK>>
  --
  name : VARCHAR(200)
  address : TEXT
  capacity : INTEGER
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "events" as events {
  * id : UUID <<PK>>
  --
  organizer_id : UUID <<FK>>
  venue_id : UUID <<FK>>
  name : VARCHAR(200)
  description : TEXT
  status : event_status
  start_date : TIMESTAMPTZ
  end_date : TIMESTAMPTZ
  image_url : TEXT
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "event_sessions" as event_sessions {
  * id : UUID <<PK>>
  --
  event_id : UUID <<FK>>
  start_time : TIMESTAMPTZ
  end_time : TIMESTAMPTZ
  capacity : INTEGER
  registration_open_at : TIMESTAMPTZ
  registration_close_at : TIMESTAMPTZ
  allocation_policy : allocation_policy
  status : session_status
  created_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "registrations" as registrations {
  * id : UUID <<PK>>
  --
  attendee_id : UUID <<FK>>
  session_id : UUID <<FK>>
  status : registration_status
  registered_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
  --
  UQ(attendee_id, session_id)
}

entity "waitlist_entries" as waitlist_entries {
  * id : UUID <<PK>>
  --
  registration_id : UUID <<FK, UQ>>
  position : BIGINT
  joined_at : TIMESTAMPTZ
  status : waitlist_status
  updated_at : TIMESTAMPTZ
}

entity "tickets" as tickets {
  * id : UUID <<PK>>
  --
  registration_id : UUID <<FK, UQ>>
  ticket_code : VARCHAR(100) <<UQ>>
  qr_code : TEXT
  status : ticket_status
  issued_at : TIMESTAMPTZ
  updated_at : TIMESTAMPTZ
}

entity "check_ins" as check_ins {
  * id : UUID <<PK>>
  --
  ticket_id : UUID <<FK, UQ>>
  staff_id : UUID <<FK>>
  checked_in_at : TIMESTAMPTZ
  method : check_in_method
}

entity "accessibility_features" as accessibility_features {
  * id : UUID <<PK>>
  --
  name : VARCHAR(120) <<UQ>>
  description : TEXT
}

entity "event_accessibility" as event_accessibility {
  * event_id : UUID <<PK, FK>>
  * accessibility_feature_id : UUID <<PK, FK>>
}

entity "allocation_runs" as allocation_runs {
  * id : UUID <<PK>>
  --
  session_id : UUID <<FK>>
  policy : allocation_policy
  executed_at : TIMESTAMPTZ
  candidate_count : INTEGER
  confirmed_count : INTEGER
  metadata : JSONB
}

users ||--o{ events : organizer_id
venues ||--o{ events : venue_id
events ||--|{ event_sessions : event_id

users ||--o{ registrations : attendee_id
event_sessions ||--o{ registrations : session_id
registrations ||--o| waitlist_entries : registration_id
registrations ||--o| tickets : registration_id
tickets ||--o| check_ins : ticket_id
users ||--o{ check_ins : staff_id

events ||--o{ event_accessibility : event_id
accessibility_features ||--o{ event_accessibility : accessibility_feature_id

event_sessions ||--o{ allocation_runs : session_id

note right of registrations
DB constraint bắt buộc:
UNIQUE(attendee_id, session_id)
=> một Attendee chỉ có một Registration cho một Session.
end note

note right of tickets
UNIQUE(registration_id)
=> một Registration có tối đa một Ticket.
Ticket chỉ được tạo khi Registration = CONFIRMED
(do service/transaction bảo vệ).
end note

note right of check_ins
UNIQUE(ticket_id)
=> một Ticket chỉ có tối đa một CheckIn record.
Check-in đồng thời phải dùng transaction/locking
để chỉ một request thành công.
end note

note bottom of event_sessions
CHECK đề xuất:
- capacity > 0
- start_time < end_time
- registration_open_at < registration_close_at
- capacity <= Venue.capacity được kiểm tra ở service
  vì là rule liên bảng.
end note

note bottom of allocation_runs
metadata JSONB lưu dữ liệu audit cần thiết,
ví dụ algorithm version, random seed/hash,
ordered candidate ids hoặc bằng chứng tương đương.
end note

note bottom of events
image_url chỉ là URL/metadata.
Ảnh thật nằm ở object storage.
end note

@enduml
