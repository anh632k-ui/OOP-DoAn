@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13
skinparam componentStyle rectangle
skinparam packageStyle rectangle

title MED-06 - BIỂU ĐỒ THÀNH PHẦN

actor "Người dùng web" as NguoiDung
component "Ứng dụng web Next.js" as GiaoDien

rectangle "Khối nguyên khối mô-đun NestJS" as MayChu {
  component "API HTTP / Bộ điều khiển" as API
  component "Xác thực và Người dùng" as NguoiDungModule
  component "Sự kiện và Suất" as SuKienModule
  component "Hỗ trợ tiếp cận và Tìm kiếm" as TimKiemModule
  component "Đăng ký" as DangKyModule
  component "Phân bổ và Danh sách chờ" as PhanBoModule
  component "Vé và Check-in" as VeModule
  component "Kho dữ liệu / Lớp lưu trữ" as DuLieu

  API --> NguoiDungModule
  API --> SuKienModule
  API --> TimKiemModule
  API --> DangKyModule
  API --> PhanBoModule
  API --> VeModule

  DangKyModule --> PhanBoModule : FCFS / LOTTERY
  PhanBoModule --> VeModule : phát vé
  SuKienModule --> TimKiemModule : dữ liệu sự kiện

  NguoiDungModule ..> DuLieu
  SuKienModule ..> DuLieu
  TimKiemModule ..> DuLieu
  DangKyModule ..> DuLieu
  PhanBoModule ..> DuLieu
  VeModule ..> DuLieu
}

database "PostgreSQL" as CSDL
cloud "Kho lưu trữ đối tượng\nS3 / MinIO" as KhoAnh

NguoiDung --> GiaoDien
GiaoDien --> API : HTTPS REST/JSON
DuLieu --> CSDL
SuKienModule --> KhoAnh : ảnh sự kiện

note bottom of PhanBoModule
Chiến lược phân bổ vé:
FCFS + LOTTERY
end note

note bottom of MayChu
Một phía máy chủ triển khai duy nhất;
chia mô-đun theo miền nghiệp vụ,
không dùng vi dịch vụ trong MVP.
end note
@enduml
