@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13
skinparam componentStyle rectangle
skinparam packageStyle rectangle

title MED-06 - COMPONENT DIAGRAM

actor "Web User" as User
component "Next.js Web App" as FE

rectangle "NestJS Modular Monolith" as BE {
  [HTTP API / Controllers] as API

  [Auth & Users] as IAM
  [Events & Sessions] as EVT
  [Accessibility & Search] as QUERY
  [Registrations] as REG
  [Allocation & Waitlist] as ALLOC
  [Tickets & Check-in] as TIX

  [Repositories / Persistence] as DATA

  API --> IAM
  API --> EVT
  API --> QUERY
  API --> REG
  API --> ALLOC
  API --> TIX

  REG --> ALLOC : FCFS / LOTTERY
  ALLOC --> TIX : issue ticket
  EVT --> QUERY : event metadata

  IAM ..> DATA
  EVT ..> DATA
  QUERY ..> DATA
  REG ..> DATA
  ALLOC ..> DATA
  TIX ..> DATA
}

database "PostgreSQL" as DB
cloud "Object Storage\nS3 / MinIO" as OS

User --> FE
FE --> API : HTTPS REST/JSON
DATA --> DB
EVT --> OS : event images

note bottom of ALLOC
TicketAllocationStrategy
FCFS + LOTTERY
end note

note bottom of BE
Một backend deployable duy nhất;
module hóa theo domain, không dùng microservices trong MVP.
end note

@enduml
