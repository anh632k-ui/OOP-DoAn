@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13

title MED-06 - BIỂU ĐỒ TRIỂN KHAI

node "Thiết bị người dùng" as ThietBi {
  artifact "Trình duyệt web" as TrinhDuyet
}

node "Máy chủ Docker" as MayChu {
  node "Khối giao diện" as GiaoDien {
    artifact "Ứng dụng Next.js" as NextApp
  }

  node "Khối phía máy chủ" as BackendNode {
    artifact "API NestJS" as NestApi
  }

  node "Khối cơ sở dữ liệu" as CSDLNode {
    database "PostgreSQL" as PostgreSQL
  }

  node "Khối lưu trữ đối tượng\n(phát triển / kiểm thử)" as KhoNode {
    artifact "MinIO" as MinIO
  }
}

cloud "Kho lưu trữ tương thích S3\n(phương án triển khai thật)" as S3

TrinhDuyet --> NextApp : HTTPS
NextApp --> NestApi : REST/JSON HTTPS
NestApi --> PostgreSQL : kết nối SQL
NestApi --> MinIO : API S3
NestApi ..> S3 : API S3 [triển khai thật]
@enduml
