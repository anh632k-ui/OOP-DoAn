@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13

title MED-06 - BIỂU ĐỒ TRIỂN KHAI

node "Thiết bị người dùng" as ThietBi {
  artifact "Trình duyệt web" as TrinhDuyet
}

node "Máy chủ / Docker" as MayChu {
  node "Khối giao diện" as GiaoDien {
    artifact "Ứng dụng Next.js" as Next
  }

  node "Khối phía máy chủ" as Backend {
    artifact "API NestJS" as API
  }

  node "Khối cơ sở dữ liệu" as CSDLNode {
    database "PostgreSQL" as PG
  }

  node "Khối lưu trữ đối tượng
(phát triển/kiểm thử)" as KhoNode {
    artifact "MinIO" as MinIO
  }
}

cloud "Kho lưu trữ tương thích S3
(phương án triển khai thật)" as S3

TrinhDuyet --> Next : HTTPS
Next --> API : REST/JSON HTTPS
API --> PG : kết nối SQL
API --> MinIO : API S3
API ..> S3 : API S3 [triển khai thật]
@enduml
