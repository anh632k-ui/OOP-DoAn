@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13

title MED-06 - DEPLOYMENT DIAGRAM

node "Client Device" as CLIENT {
  artifact "Web Browser" as Browser
}

node "Docker Host / Server" as HOST {
  node "frontend container" as FE {
    artifact "Next.js App" as Next
  }

  node "backend container" as BE {
    artifact "NestJS API" as API
  }

  node "database container" as DBNODE {
    database "PostgreSQL" as PG
  }

  node "object-storage container\n(dev/test)" as STORAGE {
    artifact "MinIO" as MinIO
  }
}

cloud "S3-compatible Storage\n(production option)" as S3

Browser --> Next : HTTPS
Next --> API : REST/JSON HTTPS
API --> PG : SQL connection
API --> MinIO : S3 API
API ..> S3 : S3 API [production]

FE -[hidden]down-> BE
BE -[hidden]down-> DBNODE
DBNODE -[hidden]down-> STORAGE

@enduml
