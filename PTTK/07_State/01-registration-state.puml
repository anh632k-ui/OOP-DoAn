@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13
skinparam state {
  BackgroundColor White
  BorderColor Black
}

title MED-06 - STATE: REGISTRATION

[*] --> PENDING : tạo Registration

PENDING --> CONFIRMED : FCFS còn chỗ / trúng LOTTERY
PENDING --> WAITLISTED : FCFS đầy / không trúng LOTTERY
PENDING --> CANCELLED : hủy hoặc Session bị hủy

WAITLISTED --> CONFIRMED : promote
WAITLISTED --> CANCELLED : hủy hoặc Session bị hủy

CONFIRMED --> CANCELLED : hủy trước Session / Session bị hủy
CONFIRMED --> [*] : Session hoàn tất
CANCELLED --> [*]

@enduml
