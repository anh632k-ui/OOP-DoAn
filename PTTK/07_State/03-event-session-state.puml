@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13
skinparam state {
  BackgroundColor White
  BorderColor Black
  FontColor Black
}
title MED-06 - TRẠNG THÁI: SUẤT SỰ KIỆN
state "NHÁP" as Nhap
state "ĐANG MỞ ĐĂNG KÝ" as MoDangKy
state "ĐÃ ĐÓNG ĐĂNG KÝ" as DongDangKy
state "ĐANG DIỄN RA" as DangDienRa
state "HOÀN THÀNH" as HoanThanh
state "ĐÃ HỦY" as DaHuy
[*] --> Nhap : tạo suất
Nhap --> MoDangKy : mở đăng ký
MoDangKy --> DongDangKy : hết hạn / Ban tổ chức đóng
DongDangKy --> DangDienRa : đến giờ bắt đầu
DangDienRa --> HoanThanh : kết thúc suất
HoanThanh --> [*]
Nhap --> DaHuy : hủy
MoDangKy --> DaHuy : hủy
DongDangKy --> DaHuy : hủy
DangDienRa --> DaHuy : hủy bất thường
DaHuy --> [*]
@enduml
