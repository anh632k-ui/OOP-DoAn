@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13
skinparam state {
  BackgroundColor White
  BorderColor Black
}

title MED-06 - STATE: EVENT SESSION

[*] --> DRAFT : tạo Session
DRAFT --> REGISTRATION_OPEN : mở đăng ký
REGISTRATION_OPEN --> REGISTRATION_CLOSED : hết hạn / Organizer đóng
REGISTRATION_CLOSED --> ONGOING : đến giờ bắt đầu
ONGOING --> COMPLETED : kết thúc suất
COMPLETED --> [*]

DRAFT --> CANCELLED : hủy
REGISTRATION_OPEN --> CANCELLED : hủy
REGISTRATION_CLOSED --> CANCELLED : hủy
ONGOING --> CANCELLED : hủy bất thường
CANCELLED --> [*]

@enduml
