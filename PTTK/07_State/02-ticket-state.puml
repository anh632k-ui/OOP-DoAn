@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13
skinparam state {
  BackgroundColor White
  BorderColor Black
}

title MED-06 - STATE: TICKET

[*] --> VALID : issue khi Registration CONFIRMED
VALID --> USED : check-in thành công
VALID --> CANCELLED : Registration / Session bị hủy
VALID --> EXPIRED : quá hạn sử dụng

USED --> [*]
CANCELLED --> [*]
EXPIRED --> [*]

@enduml
