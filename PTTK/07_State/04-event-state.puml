@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13
skinparam state {
  BackgroundColor White
  BorderColor Black
  FontColor Black
}
title MED-06 - TRẠNG THÁI: SỰ KIỆN
state "NHÁP" as Nhap
state "ĐÃ CÔNG BỐ" as DaCongBo
state "HOÀN THÀNH" as HoanThanh
state "ĐÃ HỦY" as DaHuy
[*] --> Nhap : tạo sự kiện
Nhap --> DaCongBo : công bố [>= 1 suất hợp lệ]
DaCongBo --> HoanThanh : toàn bộ lịch kết thúc
HoanThanh --> [*]
Nhap --> DaHuy : hủy
DaCongBo --> DaHuy : hủy
DaHuy --> [*]
@enduml
