@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13
skinparam state {
  BackgroundColor White
  BorderColor Black
}

title MED-06 - STATE: EVENT

[*] --> DRAFT : tạo Event
DRAFT --> PUBLISHED : publish [>= 1 Session hợp lệ]
PUBLISHED --> COMPLETED : toàn bộ lịch kết thúc
COMPLETED --> [*]

DRAFT --> CANCELLED : hủy
PUBLISHED --> CANCELLED : hủy
CANCELLED --> [*]

@enduml
